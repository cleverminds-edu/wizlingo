{
  "name": "WizLingo - English Learning Platform",
  "short_name": "WizLingo",
  "description": "AI-powered English reading & speaking practice platform for schools",
  "start_url": "/login",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#ffffff",
  "theme_color": "#F97316",
  "icons": [
    {
      "src": "/wizlingo-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/wizlingo-icon.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "maskable any"
    },
    {
      "src": "/wizlingo-icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable any"
    }
  ],
  "categories": ["education", "productivity"],
  "shortcuts": [
    {
      "name": "Reading Session",
      "short_name": "Read",
      "description": "Start a reading practice session",
      "url": "/student/session?mode=reading"
    },
    {
      "name": "Speaking Session",
      "short_name": "Speak",
      "description": "Start a speaking practice session",
      "url": "/student/session?mode=speaking"
    },
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "View your progress and achievements",
      "url": "/student/dashboard"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
